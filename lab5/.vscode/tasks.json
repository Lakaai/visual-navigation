{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "set-cpu-affinity",
            "type": "shell",
            "command": "taskset",
            "args": ["-c", "0-7", "${input:programToDebug}"],
            "isBackground": true,
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "programToDebug",
            "type": "promptString",
            "description": "Enter the path to the program you want to debug"
        }
    ]
}